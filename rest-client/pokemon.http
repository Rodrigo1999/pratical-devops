### Listar todos os pokemons capturados
GET {{BASE_URL}}/pokemons
content-type: application/json

### Captura um pokemon
POST {{BASE_URL}}/pokemons/capture
content-type: application/json

{
    "poke_id": "poke_19",
    "cep": "64640000"
}

### Evolui um pokemon
PUT {{BASE_URL}}/pokemons/evolve/1
content-type: application/json

### Recaptura um pokemon
POST {{BASE_URL}}/pokemons/recapture
content-type: application/json

{
    "poke_id": "poke_19",
    "cep": "64607715"
}

### Libera/abandona um pokemon
DELETE {{BASE_URL}}/pokemons/release/r0o6l24f628
content-type: application/json

# --------------------------------------------------------------------------
### Checa a saúde da aplicação
GET {{BASE_URL}}/healthz
content-type: application/json

### Mudo o estado de heatlty da minha aplicação
PUT {{BASE_URL}}/healthz
content-type: application/json

### ESTRESSA A CPU
GET {{BASE_URL}}/stress-cpu?iterations=45
content-type: application/json

### ESTRESSA A MEMÓRIA
GET {{BASE_URL}}/stress-memory
content-type: application/json